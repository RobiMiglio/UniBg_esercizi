{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run in external terminal",
            "type": "shell",
            "command": "xterm",
            "args": [
                "-hold",
                "-e",
                "g++ '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
